{
  "name": "stechoq-hardware-simulation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "predev": "node scripts/require-node.mjs",
    "dev": "vite",
    "prebuild": "node scripts/require-node.mjs",
    "build": "tsc --noEmit && vite build",
    "prepreview": "node scripts/require-node.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "esbuild src/simulators/engine.check.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.check/engine.check.mjs && node .check/engine.check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
